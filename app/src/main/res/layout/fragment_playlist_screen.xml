<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".library.ui.playlist_screen.PlaylistScreenFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/light_gray">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/transparent"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title=""
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/playlist_cover_im"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="20dp"
                android:src="@drawable/track_placeholder"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/playlist_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="4dp"
                android:fontFamily="@font/ys_display_medium"
                android:textColor="@color/black"
                android:textFontWeight="700"
                android:textSize="24sp"
                app:layout_constraintTop_toBottomOf="@+id/playlist_cover_im"
                tools:text="Best songs 2021" />

            <TextView
                android:id="@+id/playlist_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="4dp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/black"
                android:textFontWeight="400"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@+id/playlist_title"
                tools:text="2022" />

            <TextView
                android:id="@+id/playlist_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="4dp"
                android:fontFamily="@font/ys_display_regular"
                android:textColor="@color/black"
                android:textFontWeight="400"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@+id/playlist_description"
                tools:text="@string/playlist_descriptor" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ic_share"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="12dp"
                android:src="@drawable/ic_share"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/playlist_info"
                app:tint="@color/black" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ic_menu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="12dp"
                android:src="@drawable/ic_menu"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toEndOf="@+id/ic_share"
                app:layout_constraintTop_toBottomOf="@id/playlist_info"
                app:tint="@color/black" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/playlists_bottom_sheet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="24dp"
                app:behavior_hideable="false"
                app:cardBackgroundColor="?attr/colorSecondary"
                app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ic_share"
                app:shapeAppearanceOverlay="@style/BottomSheetRoundedShape">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <View
                        android:layout_width="50dp"
                        android:layout_height="4dp"
                        android:layout_gravity="center"
                        android:layout_marginVertical="12dp"
                        android:background="@drawable/bottomsheet_upper_line" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/tracks_recycler_bottom_sheet"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_track"
                        tools:itemCount="0"/>



                        <ImageView
                            android:id="@+id/placeholder_im"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:src="@drawable/im_not_found" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/placeholder_title"
                            style="@style/PlaceholderText.Title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="@string/playlist_no_added_tracks_placeholder_description" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/options_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:behavior_hideable="true"
        app:behavior_peekHeight="auto"
        app:cardBackgroundColor="?attr/colorSecondary"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:shapeAppearanceOverlay="@style/BottomSheetRoundedShape"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <View
                android:layout_width="50dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:layout_marginVertical="12dp"
                android:background="@drawable/bottomsheet_upper_line" />

            <include
                android:id="@+id/item_playlist_horizontal"
                layout="@layout/item_playlist_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/share_playlist"
                style="@style/SettingItemTextView"
                android:text="@string/playlist_share_text" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/edit_playlist"
                style="@style/SettingItemTextView"
                android:text="@string/playlist_edit_playlist_text" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/delete_playlist"
                style="@style/SettingItemTextView"
                android:text="@string/playlist_delete_text" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>