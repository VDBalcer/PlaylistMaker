<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPlaylist"
    app:cardBackgroundColor="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp"
        >
        <ImageView
            android:id="@+id/playlist_cover_im"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingBottom="4dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/track_placeholder"/>
        <TextView
            android:id="@+id/playlist_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSecondary"
            android:fontFamily="@font/ys_display_regular"
            android:fontWeight="@dimen/regular_font_weight"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/playlist_cover_im"
            tools:text="Тестовый плейлист"/>
        <TextView
            android:id="@+id/playlist_tracks_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSecondary"
            android:fontFamily="@font/ys_display_regular"
            android:fontWeight="@dimen/regular_font_weight"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@+id/playlist_title"
            tools:text="2 трека"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>